{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Strict least-privilege capability profile for API Studio main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-app-read",
    "fs:allow-app-write"
  ]
}
